<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.serviceModel>
		<services>
			<service name="Server.Services.MotorService"
					 behaviorConfiguration="MotorServiceBehavior">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4000"/>
					</baseAddresses>
				</host>
				<endpoint
				  address="MotorService"
				  binding="netTcpBinding"
				  bindingConfiguration="MotorTcpBinding"
				  contract="Common.Contracts.IMotorService"/>
			</service>
		</services>

		<bindings>
			<netTcpBinding>
				<binding name="MotorTcpBinding"
						 maxReceivedMessageSize="10485760"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:10:00"
						 openTimeout="00:01:00"
						 closeTimeout="00:01:00"
						 transferMode="Buffered">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>

		<behaviors>
			<serviceBehaviors>
				<behavior name="MotorServiceBehavior">
					<serviceMetadata/>
					<serviceDebug includeExceptionDetailInFaults="true"/>
				</behavior>
			</serviceBehaviors>
		</behaviors>
	</system.serviceModel>

	<appSettings>
		<add key="Id_threshold" value="0.5"/>
		<add key="Iq_threshold" value="0.5"/>
		<add key="T_threshold" value="2.0"/>
		<add key="AverageTolerance" value="0.25"/>
		<add key="FilePath" value="Files"/>
	</appSettings>
</configuration>